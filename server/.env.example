PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/gensou_hub
CLIENT_ORIGIN=http://localhost:5173
NODE_ENV=development
MAX_AUDIO_MB=50
MAX_COVER_MB=5
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
MAX_WALLPAPER_MB=10

# LAN access: HOST=0.0.0.0 listens on every interface so other devices on the
# network can reach the API. Use 127.0.0.1 to keep it on this machine only.
# CLIENT_ORIGIN accepts a comma-separated list. ALLOW_LAN_ORIGINS=false turns off
# the automatic allowance for private/LAN addresses.
HOST=0.0.0.0
ALLOW_LAN_ORIGINS=true

# Where uploads are kept. Left unset, this is decided by the environment: files
# go to a Vercel Blob store when BLOB_READ_WRITE_TOKEN is present (Vercel sets
# it for you once a store is linked to the project), and to ./uploads otherwise.
# Set it to "blob" or "disk" to force one, which is how you exercise the blob
# path from your own machine — with a token pasted in below.
# STORAGE_DRIVER=disk
# BLOB_READ_WRITE_TOKEN=

# On Vercel the client and the API share one origin, and a request from the
# site to its own API is always accepted — so the deployment works without
# CLIENT_ORIGIN. Set ALLOW_LAN_ORIGINS=false there, so nothing else gets in.
# CLIENT_ORIGIN is only needed for a client served from some other domain.
